# Meta Model API (one key covers Muse Spark, Voice Transcribe, SAM 3.1, Muse Image)
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
CHAT_MODEL=muse-spark-1.3
TRANSCRIBE_MODEL=muse-voice-transcribe-1.0
SAM_MODEL=sam-3.1
SAM_ENDPOINT=

# Which backend runs the agent: "meta", "baseten" or "fireworks" (both Muse Spark Open)
LLM_BACKEND=meta
BASETEN_API_KEY=
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://us.api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/muse-spark-open

# Voice notes: "baseten" (Muse Spark Open hears the audio), "meta" (Muse Voice Transcribe)
# or "fireworks" (Whisper). Empty: baseten when LLM_BACKEND=baseten, else meta.
TRANSCRIBE_BACKEND=

# Your shop: business info, links, products, contacts, opening stock (see seed/my_shop.example.json). Empty = demo shop.
SHOP_FILE=

# Signs business-statement share links (7 days). Empty = OWNER_APP_TOKEN.
STATEMENT_SECRET=

# WhatsApp Cloud API
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=pick-any-random-string
META_APP_SECRET=
GRAPH_VERSION=v21.0

# The shop owner's WhatsApp number (digits only, with country code, e.g. 2348012345678)
OWNER_PHONE=

# Storage: "memory" for local dev, "postgres" for Supabase
STORE=memory
DATABASE_URL=

# Auto-post limit for sales, in naira
AUTO_POST_LIMIT_NAIRA=50000

# Promotion
IMAGE_MODEL=muse-image-1.0
PUBLIC_BASE_URL=
MEDIA_DIR=media_cache
IG_USER_ID=
FB_PAGE_ID=
PAGE_ACCESS_TOKEN=
SHOP_WHATSAPP_DISPLAY=
STOCKTAKE_BACKEND=

# Owner app (long random string; the app asks for it once)
OWNER_APP_TOKEN=
PRIVATE_MEDIA_DIR=private_media

# Payment reminder template (submit once: python scripts/create_reminder_template.py --submit)
WABA_ID=
WA_REMINDER_TEMPLATE=payment_reminder
WA_REMINDER_TEMPLATE_LANG=en

# Public "Try Sabi" demo at /demo/ (one private demo shop per visitor)
DEMO_ENABLED=1
DEMO_MAX_MESSAGES=40
DEMO_DAILY_MESSAGES=2000
DEMO_MAX_SESSIONS=200

# Pilot shops: real testers, each with her own books, a Chat tab in the owner app and a customer chat link.
# A Postgres URL, or pgserver:<folder> for an embedded Postgres kept in that folder (pip install pgserver). Empty = off.
SHOPS_DB=
# A pilot shop's link name (the end of her /c/ link, e.g. broadway-books): the WhatsApp number answers
# as that shop. Her own number is her; anyone else is her customer. Empty = the main shop.
WA_SHOP=
# /admin/ page: create shops, hand out app links, read chats and feedback. Empty = OWNER_APP_TOKEN.
ADMIN_TOKEN=
SHOP_DAILY_MESSAGES=400
# Contact address phone push services see with each notification (any mailto: or https: address).
VAPID_SUBJECT=mailto:sabi-pilot@example.com
